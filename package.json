{
  "name": "maskit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Local-first PII/PHI/secrets masking for AI prompts",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @maskit/e2e e2e",
    "bench": "pnpm --filter @maskit/bench bench"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "20",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vitest": "^2.1.8"
  }
}

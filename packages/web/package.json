{
  "name": "@maskit/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-model.mjs && node scripts/prepare-ocr.mjs && vite",
    "build": "node scripts/prepare-model.mjs && node scripts/prepare-ocr.mjs && tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare-model": "node scripts/prepare-model.mjs",
    "prepare-ocr": "node scripts/prepare-ocr.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.3.3",
    "@maskit/core": "workspace:*",
    "@maskit/files": "workspace:*",
    "@maskit/ner": "workspace:*",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  }
}
